####################################################################################################
# Title: GATK MarkDuplicates for RNA-seq BAM Files
# Author: R. Meller
# Date: 2024 March
#
# Description:
#   - Mark duplicate reads in the STAR-Bowtie2 aligned BAM files
#   - Generate duplicate metrics for each sample
#   - Index the marked BAM files for downstream GATK analysis
#
# Input:
#   - Coordinate-sorted STAR-Bowtie2 BAM files
#   - Project folder
#
# Output:
#   - BAM files with duplicate reads marked
#   - Duplicate metrics files
#   - BAM index files
#
# Usage:
#   cat samples.txt | parallel -j 8 ./05A_GATK-1.sh
#
# Software:
#   - GATK
#   - SAMtools
#
# Note: For GATK RNA-seq variant calling, we used STAR-aligned BAM files only because STAR is 
#       splice-aware and preserves the gapped CIGAR structures required by GATK SplitNCigarReads; 
#       Bowtie2 is not splice-aware and was therefore excluded from this step. 
#####################################################################################################
#####################################################################################################

#!/bin/bash

start=$(date +%s)
echo "start time: $start"
echo "running on $HOSTNAME"
echo "sample name = $1"

## make and define folders
PROJECTS="/path/to/project/folder"

# create output folder
mkdir ${PROJECTS}/ANALYSIS/${1}/04_GATK
out_dir="${PROJECTS}/ANALYSIS/${1}/04_GATK"

# now define input folder
in_dir="${PROJECTS}/ANALYSIS/${1}/03_GRCH38_AlignedData"
cd ${in_dir}

## define files for STAR
REF="/path/to/reference/folder/Homo.sapiens.dna.mainchrs.fa"
echo ${REF}

GTF="/path/to/reference/folder/Homo_sapiens.GRCh38.109.gtf"
echo ${GTF}

## Each folder contains multiple folders of each sequencing chips worth of data.  


for DIR in $(ls | grep -v ".txt" )

do
	echo "$DIR"
	mkdir ${out_dir}/${DIR}
	gatkout="${out_dir}/${DIR}"

#This creates an item (call of the program) the call is echo’ed and then ran with eval. This is useful for running large numbers of files with and collecting log files for the run, so you can see what went wrong. 
 

call1a="GATK MarkDuplicates -I ${in_dir}/${DIR}/${DIR}Aligned.sortedByCoord.out.bam \
-O ${out_dir}/${DIR}/${DIR}_marked_duplicates.bam \
-M ${out_dir}/${DIR}/${DIR}_marked_dup_metrics.txt"

echo $call1a
eval $call1a


call1b="samtools index -@ 12 ${out_dir}/${DIR}/${DIR}_marked_duplicates.bam"

echo $call1b
eval $call1b

done


end=$(date +%s)
echo "end time: $end"
runtime_s=$(echo $(( end - start )))
echo " time in sec: $runtime_s"
sec_per_min=60
sec_per_hr=3600
runtime_m=$(echo "scale=2; $runtime_s / $sec_per_min;" | bc)
echo "total run time Min: $runtime_m"
runtime_h=$(echo "scale=2; $runtime_s / $sec_per_hr;" | bc)
echo "total run time hours : $runtime_h"

