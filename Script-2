start=$(date +%s)
echo "start time: $start"
echo "running on $HOSTNAME"
echo "sample name = $1"

## make and define folders
PROJECTS="/path/to/project/folder/"

# set the path for output folder
out_dir="${PROJECTS}/ANALYSIS/${1}/04_GATK"

# now define input folder
in_dir="${PROJECTS}/ANALYSIS/${1}/04_GATK"
cd ${in_dir}

## define files for STAR
REF_DIR="/path/to/reference/folder/GRCH38_MainChrs"
REF="/path/to/reference/folder/Homo_sapiens.GRCh38.dna.mainchrs.fa"
echo ${REF}

GTF="/path/to/reference/folder/Homo_sapiens.GRCh38.109.gtf"
echo ${GTF}
vcf_refs="/path/to/reference/folder/GRCH38_MainChrs/VCF_Files/"
echo ${vcf_refs}

## Each folder contains multiple folders of each sequencing chips worth of data.  

for DIR in $(ls | grep -v ".txt" )

do
	echo "$DIR"
	#mkdir ${out_dir}/${DIR}
	gatkout="${out_dir}/${DIR}"
	echo ${gatkout}

#This creates an item (call of the program) the call is echo’ed and then ran with eval. This is useful for running large numbers of files with and collecting log files for the run, so you can see what went wrong. 


call6="GATK --java-options "-Xmx100G" HaplotypeCaller \
	-R ${REF} \
	-I ${out_dir}/${DIR}/${1}_BSQR-applied.out.bam \
	-O ${out_dir}/${1}.vcf.gz \
	-ERC GVCF \
	--standard-min-confidence-threshold-for-calling 10 \
	-G StandardAnnotation \
	-G AS_StandardAnnotation"


echo $call6
eval $call6

done

end=$(date +%s)
