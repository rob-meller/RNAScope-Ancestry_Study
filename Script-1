# Title: RNA-seq Read Trimming and Quality Control
# Author: R. Meller
# Date: 2024 March
#
# Description:
#   - Trim adapter sequences and low-quality bases from paired-end FASTQ files
#   - Run FastQC after trimming
#   - Save the trimmed FASTQ files in the sample-specific analysis directory
#
# Input:
#   - Paired-end FASTQ files (_R1_001.fastq.gz and _R2_001.fastq.gz)
#   - Project folder
#
# Output:
#   - Trimmed paired-end FASTQ files
#   - FastQC quality control reports
#
# Usage:
#   cat samples.txt | parallel -j 8 /path/to/02_TrimGalore.sh
#
# Software:
#   - Trim Galore
#   - FastQC
##################################################################################
##################################################################################

#!/bin/bash

PROJECT="/path/to/project/folder"

echo working on sample ${1}
indir="${PROJECT}/${1}/01_Fastq"
mkdir ${PROJECT}/${1}/02_TrimmedFastq
outdir="${PROJECT}/${1}/02_TrimmedFastq"
cd $indir
pwd

start=$(date +%s)
echo "start time =${start}"



## Now loop trimgalore on *.fq.gz files in directory
	echo running Trim_Galore on sample: ${1}
	trim_galore --paired \
			--fastqc \
			-j 4 \
			-q 20 \
			--gzip \
			${1}_R1_001.fastq.gz \
			${1}_R2_001.fastq.gz \
			 --output_dir ${outdir}

##could be a zipping issue so..
gunzip ${outdir}/${1}_R1_001_val_1.fq.gz
gunzip ${outdir}/${1}_R2_001_val_2.fq.gz 

end=$(date +%s)
echo "end time = ${end}"
runtime_s=(${end} - ${start})
echo "runtime = ${runtime_s}"


