#####################################################################################
#####################################################################################
# Title: RNA-seq Alignment to GRCh38 Using STAR and Bowtie2
# Author: R. Meller
# Date: 2024 March
#
# Description:
#   - Align paired-end RNA-seq reads to the GRCh38 reference genome using STAR
#   - Extract unmapped reads from the STAR alignment
#   - Remap the unmapped reads using Bowtie2
#   - Merge the STAR and Bowtie2 alignments into a single BAM file
#
# Input:
#   - Paired-end FASTQ files (_R1_001_val_1.fq and _R2_001_val_2.fq)
#   - GRCh38 reference genome and annotation
#   - Bowtie2 reference index
#
# Output:
#   - STAR coordinate-sorted BAM file
#   - Bowtie2 BAM file for unmapped reads
#   - Combined STAR-Bowtie2 BAM file
#
# Usage:
#   cat samples.txt | parallel -j 8 ./03A_STAR-Bowtie2_GRCH.sh
#
# Software:
#   - STAR
#   - Bowtie2
#   - SAMtools
#   - Picard
#####################################################################################
#####################################################################################

echo "running on $HOSTNAME"
echo "sample name = $1"

## make and define folders
PROJECTS="/path/to/project/folder"

echo working on sample ${1}
in_dir="${PROJECTS}/ANALYSIS/${1}/02_TrimmedFastq"
mkdir ${PROJECTS}/ANALYSIS/${1}/03_GRCH38_AlignedData
out_dir="${PROJECTS}/ANALYSIS/${1}/03_GRCH38_AlignedData"

## define files for STAR
REF="/path/to/reference/folder/GRCH38_MainChrs"
echo ${REF}

GTF="/path/to/reference/folder/Homo_sapiens.GRCh38.109.gtf"
echo ${GTF}

BOWTIE2REF="/path/to/reference/folder/GRCH38_MAINChrs"
echo ${BOWTIE2REF}


# You will have a bunch of fastq files.  First extract the core name.
# Remove the extras at the end of the name, so that the resultant bam file looks nice

cd ${in_dir}
for fastq in $(ls *.fq | rev | cut -c 20-| rev | uniq)

do
	echo "STAR version: "
	STAR --version
	mkdir ${out_dir}/${fastq}
	echo "SAMPLE: ${fastq}"

#This creates an item (call of the program) the call is echo’ed and then ran with eval. 
# this is useful for running large numbers of files with and collecting log files for the run, so you can see what went wrong. 
 

	call1="STAR --twopassMode Basic \
	--limitBAMsortRAM 20000000000 \
	--genomeDir ${REF} \
        --outReadsUnmapped Fastx \
	--sjdbGTFfile ${GTF} \
	--outFilterType BySJout \
	--outSAMattributes NH HI AS nM NM MD jM jI MC XS ch \
	--outSAMattrRGline ID:${fastq} PL:ILLUMINA PU:${fastq} LB:${1} SM:${1} \
	--outFilterMultimapNmax 5 \
	--outFilterMismatchNmax 999 \
	--outFilterMismatchNoverReadLmax 0.04 \
	--alignIntronMin 10 \
	--alignIntronMax 100000 \
	--alignMatesGapMax 100000 \
	--alignSJoverhangMin 8 \
	--alignSJDBoverhangMin 1 \
	--sjdbScore 1 \
	--readFilesCommand zcat \
	--runThreadN 8 \
	--chimOutType Junctions SeparateSAMold WithinBAM SoftClip \
	--chimOutJunctionFormat 1 \
	--chimSegmentMin 15 \
	--limitOutSJcollapsed 5000000 \
	--outSAMtype BAM SortedByCoordinate \
	--quantMode TranscriptomeSAM GeneCounts \
	--outSAMheaderHD @HD VN:1.4 SO:coordinate \
	--outFileNamePrefix ${out_dir}/${fastq}/${fastq} \
	--readFilesIn ${in_dir}/${fastq}_R1_001_val_1.fq ${in_dir}/${fastq}_R2_001_val_2.fq"

 	echo ${call1}
	eval ${call1}

	call2="bowtie2 --local --very-sensitive-local -p 8 -q --mm \ 
	-x $BOWTIE2REF -1 ${out_dir}/${fastq}/${fastq}Unmapped.out.mate1  -2 ${out_dir}/${fastq}/${fastq}Unmapped.out.mate2  | samtools view -bS - | samtools sort -o ${out_dir}/${fastq}/${fastq}_unmapped_remapped_remapBowtie2.bam - "
	 
	echo ${call2}
	eval ${call2}

	call3="PicardCommandLine MergeSamFiles USE_THREADING=true MSD=true AS=true \
	I=${out_dir}/${fastq}/${fastq}Aligned.sortedByCoord.out.bam \
	I=${out_dir}/${fastq}/${fastq}_unmapped_remapped_remapBowtie2.bam \
	O=${out_dir}/${fastq}/${fastq}_STARBowtie2.bam"
	
	echo ${call3}
	eval ${call3}

done

