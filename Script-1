# Title: SAMtools BAM Processing and Indexing
# Author: R. Meller
# Date: 2024 March
#
# Description:
#   - Prepare the STAR-Bowtie2 alignment files for downstream analysis
#   - Collect STAR-Bowtie2 BAM files from the sample directories
#   - Sort the BAM files by genomic coordinates
#   - Index the sorted BAM file
#
# Input:
#   - STAR-Bowtie2 BAM files
#
# Output:
#   - Coordinate-sorted STAR-Bowtie2 BAM file
#   - BAM index file
#
# Usage:
#   cat samples.txt | parallel -j 8 ./04_SAMTOOLS.sh
#
# Software:
#   - SAMtools
#######################################################################################
#######################################################################################

#!/bin/bash

echo "running on $HOSTNAME"
echo "sample name = $1"
start=$(date +%s)
echo "start time: $start"

## Set up directories
PROJECT="/path/to/project/folder/"

# make a results folder and designate as output
mkdir ${PROJECT}/ANALYSIS/${1}/05_Results
out_dir=${PROJECT}/ANALYSIS/${1}/05_Results

# Now move to the aligned data and set as indirectory
in_dir=${PROJECT}/ANALYSIS/${1}/03_GRCH38_AlignedData
cd ${in_dir}

echo "samtools version: "
samtools --version


#Calls
# create file with name of all of the bam files in it
call1a="ls */*_STARBowtie2.bam > bam.txt"
echo $call1a
eval $call1a

# Merge files
call1="samtools merge -@ 8 -r -b bam.txt $out_dir/$1_CombinedSTARBowtie2_Aligned.out.bam"
# Sort Files
call2="samtools sort -m 2500M --threads 8 -o ${out_dir}/${1}_STARBowtie2.SortedByCord.bam ${in_dir}/*/${1}_STARBowtie2.bam"
# index files
call3="samtools index -@ 12 $out_dir/${1}_STARBowtie2.SortedByCord.bam "

#echo $call1
#eval $call1

echo $call2
eval $call2

echo $call3
eval $call3

end=$(date +%s)
echo "end time: $end"
runtime_s=$(echo $(( end - start )))
echo "total run time(s): $runtime_s"
sec_per_min=60
sec_per_hr=3600
runtime_m=$(echo "scale=2; $runtime_s / $sec_per_min;" | bc)
echo "total run time(m): $runtime_m"
runtime_h=$(echo "scale=2; $runtime_s / $sec_per_hr;" | bc)
echo "total run time(h): $runtime_h"

