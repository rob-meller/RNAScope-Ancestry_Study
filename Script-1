##################################################################################
##################################################################################
# Title: Prepare Paired-End FASTQ Files
# Author: R. Meller
# Date: 2024 Mar
#
# Description:
#   - Copy paired-end FASTQ files from the raw data directory
#   - Create a sample-specific analysis directory
#   - Run FastQC on the FASTQ files
#
# Input:
#   - Paired-end FASTQ files (_R1_001.fastq.gz and _R2_001.fastq.gz)
#   - Batch name and sample name
#
# Output:
#   - Sample-specific FASTQ files
#   - FastQC quality control reports
#
# Usage:
#   cat samples.txt | parallel -j 8 Script/01_BamtoFastq.sh
#
# Software:
#   - FastQC
##################################################################################
##################################################################################

#!/bin/bash

PROJECT="/path/to/project/folder"
mkdir $PROJECT/ANALYSIS/${2}
mkdir $PROJECT/ANALYSIS/${2}/01_Fastq
indir=${PROJECT}/Raw_Data/${1}
outdir="$PROJECT/ANALYSIS/${2}/01_Fastq"
#cd ${indir}

## Move Bam file to in_directory

echo Sample ${2}
echo Batch ${1}


echo moving ${2} files 
echo from ${indir} 
echo to folder ${outdir}


cp ${indir}/${2}_R1_001.fastq.gz ${outdir}
cp ${indir}/${2}_R2_001.fastq.gz ${outdir}
#cd ${indir}
pwd


## now create a loop to read in the fq files and then use fastqc

for i in $(ls ${outdir} | rev | cut -c 17- | rev )
          do echo $i
          fastqc ${outdir}/${i}_*.fastq.gz

done


